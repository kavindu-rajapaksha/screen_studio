{
  "name": "screenstudio",
  "version": "1.0.0",
  "description": "Screen Studio Recording Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:exe": "electron-builder --win nsis",
    "build:msix": "electron-builder --win appx"
  },
  "keywords": [
    "screen-recorder",
    "screen-studio",
    "electron"
  ],
  "author": "Kavindu Rajapaksha",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  },
  "build": {
    "appId": "com.kavindu.screenstudio",
    "productName": "Screen Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!node_modules/.cache/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg.exe"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "appx": {
  "applicationId": "ScreenStudio",
  "displayName": "Screen Studio",
  "publisher": "CN=604A5A49-C930-4E5A-808E-FE7E632438CF",
  "identityName": "KavinduRajapaksha.ScreenStudio",
  "publisherDisplayName": "Kavindu Rajapaksha"
}
  }
}